{
  "name": "nora-backend-boilerplate",
  "version": "0.0.7",
  "author": "Marco Antonio Sánchez Pérez (Raven D. Milosh)",
  "description": "Node.js and Fastify based. Think of it as a reusable boilerplate for scalable, modular REST API projects powered by Microsoft SQL Server",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "keywords": [
    "nodejs",
    "fastify",
    "rest-api",
    "backend",
    "boilerplate",
    "microsoft-sql-server",
    "modular-monolith",
    "jwt",
    "pnpm"
  ],
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "5.2.6",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "mssql": "^12.7.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
